# Copy to .env and fill in to use real Pinecone instead of the local
# vector-store fallback (see retrieval/vector_store.py). Leave unset /
# blank to run entirely locally, including in Docker.

PINECONE_API_KEY=
PINECONE_INDEX_NAME=market-signal-headlines
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
